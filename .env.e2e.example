# Local e2e test credentials (Playwright, npm run test:e2e).
# Copy to .env.e2e (gitignored) or export directly in your shell — never
# commit real values. In CI these come from the E2E_TEST_EMAIL/
# E2E_TEST_PASSWORD repo secrets instead (see .github/workflows/ci.yml).

E2E_TEST_EMAIL=admin@sentio.ai
E2E_TEST_PASSWORD=
